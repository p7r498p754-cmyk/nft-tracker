# Локальный запуск (на GitHub Actions значения берутся из Secrets/Variables, этот файл не нужен).
# НИКОГДА не коммитьте реальные значения и не присылайте их в чат.
TELEGRAM_BOT_TOKEN=        # секрет от @BotFather
PORTALS_API_KEY=           # секрет: Portals -> Профиль -> Partner API
OWNER_CHAT_ID=0            # 0 = режим настройки (отвечает только /id); затем ваш числовой ID

# Необязательно
PORTALS_LISTING_URL_TEMPLATE=   # https-шаблон со ссылкой на лот, содержит {id}; см. README
PORTALS_PURCHASE_ACTION=buy
PRICE_UNIT=GRAM
TIMEZONE=UTC
ALLOW_NO_LINK_ALERTS=0     # 1 = слать сигналы без кнопки-ссылки (с пометкой)
DEFAULT_DISCOUNT=30
MODEL_EXTRA_MARGIN=10
LISTING_PAGES=12            # до 36 страниц по 20 событий за цикл; рост увеличит время проверок
SCAN_SECONDS=300           # только для режима loop
DB_PATH=state/tracker.sqlite3
